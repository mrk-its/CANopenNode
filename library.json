{
  "name": "CANopenNode",
  "description": "CANopen protocol stack, with the ESPHome target header (CO_driver_target.h). The application provides the CAN driver functions.",
  "keywords": "canopen, can",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CANopenNode/CANopenNode.git"
  },
  "frameworks": "*",
  "platforms": "*",
  "build": {
    "srcDir": ".",
    "includeDir": ".",
    "srcFilter": [
      "+<CANopen.c>",
      "+<301/*.c>",
      "+<303/*.c>",
      "+<304/*.c>",
      "+<305/*.c>",
      "+<309/*.c>",
      "+<extra/*.c>",
      "+<storage/CO_storage.c>"
    ]
  }
}
